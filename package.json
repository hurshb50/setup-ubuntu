{
    "name": "@hurshb50/setup-ubuntu",
    "version": "1.1.1",
    "type": "module",
    "files": [
        "distribution"
    ],
    "bin": "./distribution/setup-ubuntu.mjs",
    "scripts": {
        "build": "vp pack",
        "check": "vp check",
        "fix": "vp check --fix",
        "unit-test": "vp test --project unit",
        "integration-test": "bun scripts/integration.ts",
        "end-to-end-test": "bun scripts/end-to-end.ts"
    },
    "dependencies": {
        "@commander-js/extra-typings": "^15.0.0",
        "@types/node": "latest",
        "ansi-escapes": "^7.3.0",
        "ansi-styles": "^7.0.0",
        "execa": "^10.0.1",
        "typescript": "^7.0.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1",
        "vite-plus": "^0.2.4",
        "zod": "^4.6.5"
    },
    "overrides": {
        "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "24.21.0",
            "onFail": "download"
        },
        "packageManager": {
            "name": "pnpm",
            "version": "12.6.0",
            "onFail": "download"
        }
    },
    "description": "Sets up a fresh Ubuntu machine with a standard set of tools, configuration, and dotfiles.",
    "homepage": "https://github.com/hurshb50/setup-ubuntu#readme",
    "bugs": {
        "url": "https://github.com/hurshb50/setup-ubuntu/issues"
    },
    "license": "MIT",
    "author": "Hursh Patel <hurshb50@gmail.com>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/hurshb50/setup-ubuntu.git"
    },
    "publishConfig": {
        "access": "public"
    }
}
