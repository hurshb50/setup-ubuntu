{
    "agent": {
        "auto_compact": { "enabled": false },
        "button": false,
        "default_model": {
            "enable_thinking": false,
            "model": "deepseek-flash",
            "provider": "deepseek"
        },
        "default_profile": "minimal",
        "enable_feedback": false,
        "notify_when_agent_waiting": "all_screens",
        "profiles": {
            "ask": {
                "name": "Ask",
                "tools": {
                    "copy_path": false,
                    "create_directory": false,
                    "delete_path": false,
                    "diagnostics": true,
                    "edit_file": false,
                    "fetch": true,
                    "find_path": true,
                    "grep": true,
                    "list_directory": true,
                    "move_path": false,
                    "read_file": true,
                    "search_web": true,
                    "skill": true,
                    "spawn_agent": true,
                    "terminal": true,
                    "write_file": false
                }
            },
            "minimal": {
                "name": "Minimal",
                "tools": {
                    "fetch": true,
                    "search_web": true
                }
            },
            "write": {
                "name": "Write",
                "tools": {
                    "copy_path": true,
                    "create_directory": true,
                    "delete_path": true,
                    "diagnostics": true,
                    "edit_file": true,
                    "fetch": true,
                    "find_path": true,
                    "grep": true,
                    "list_directory": true,
                    "move_path": true,
                    "read_file": true,
                    "search_web": true,
                    "skill": true,
                    "spawn_agent": true,
                    "terminal": true,
                    "write_file": true
                }
            }
        },
        "sandbox_permissions": { "allow_all_hosts": true, "allow_fs_write_all": true },
        "thinking_display": "always_collapsed"
    },
    "agent_buffer_font_family": "Comic Code Ligatures",
    "agent_ui_font_family": "Comic Code Ligatures",
    "auto_install_extensions": {
        "catppuccin-icons": true,
        "rust-brown": true
    },
    "buffer_font_family": "Comic Code Ligatures",
    "colorize_brackets": true,
    "command_aliases": {
        "B": "workspace::ToggleBottomDock",
        "D": "debug_panel::ToggleFocus",
        "L": "workspace::ToggleLeftDock",
        "R": "workspace::ToggleRightDock",
        "S": "multi_workspace::ToggleWorkspaceSidebar",
        "f": "file_finder::Toggle",
        "only": "pane::CloseOtherItems",
        "reopen": "pane::ReopenClosedItem",
        "thread": "agent::NewThread"
    },
    "confirm_quit": true,
    "debugger": { "dock": "left" },
    "diagnostics": {
        "inline": {
            "enabled": true,
            "max_severity": "error",
            "min_column": 124,
            "padding": 0
        }
    },
    "file_finder": { "modal_max_width": "medium" },
    "git": {
        "inline_blame": {
            "delay_ms": 1000,
            "min_column": 124,
            "padding": 0
        }
    },
    "git_panel": {
        "tree_view": true
    },
    "gutter": {
        "bookmarks": false,
        "folds": false,
        "runnables": false
    },
    "icon_theme": "Catppuccin Macchiato",
    "indent_guides": {
        "coloring": "indent_aware",
        "enabled": true
    },
    "markdown_preview": {
        "font_family": "Comic Code Ligatures",
        "theme": "Rust & Brown"
    },
    "pane_split_direction_horizontal": "down",
    "pane_split_direction_vertical": "right",
    "preferred_line_length": 120,
    "project_panel": {
        "auto_fold_dirs": false,
        "bold_folder_labels": false,
        "folder_indicator": "icon",
        "git_status": false,
        "hide_gitignore": false,
        "hide_root": true,
        "show_diagnostics": "off"
    },
    "relative_line_numbers": "enabled",
    "scrollbar": { "show": "always" },
    "search": {},
    "show_call_status_icon": false,
    "show_edit_predictions": false,
    "show_whitespaces": "selection",
    "status_bar": { "experimental.show": false },
    "tab_bar": {
        "show_nav_history_buttons": false,
        "show_tab_bar_buttons": false
    },
    "tabs": {
        "file_icons": true,
        "git_status": true,
        "show_close_button": "hidden"
    },
    "terminal": {
        "bell": "system",
        "copy_on_select": true,
        "font_family": "Comic Code Ligatures"
    },
    "theme": "Rust & Brown",
    "title_bar": {
        "show_branch_name": false,
        "show_onboarding_banner": false,
        "show_sign_in": false,
        "show_user_menu": false
    },
    "toolbar": {
        "agent_review": false,
        "breadcrumbs": false,
        "quick_actions": false
    },
    "ui_font_family": "Comic Code Ligatures",
    "vim_mode": true
}
