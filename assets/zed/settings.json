{
    "lsp": {
        "vtsls": {
            "settings": {
                "typescript": {
                    "updateImportsOnFileMove": {
                        "enabled": "always"
                    }
                },
                "javascript": {
                    "updateImportsOnFileMove": {
                        "enabled": "always"
                    }
                }
            },
            "enable_lsp_tasks": true
        }
    },
    "git_panel": {
        "tree_view": true
    },
    "cli_default_open_behavior": "new_window",
    "ssh_connections": [
        {
            "host": "hursh-core",
            "args": [],
            "projects": [
                {
                    "paths": ["/home/hpatel_rai_inst_com/core"]
                }
            ]
        }
    ],
    "auto_install_extensions": {
        "catppuccin-icons": true,
        "rust-brown": true
    },
    "agent": {
        "sandbox_permissions": {
            "allow_unsandboxed": true,
            "network_hosts": [
                "www.learningtypescript.com",
                "nubjs.com",
                "oxc.rs",
                "vitest.dev",
                "registry.npmjs.org",
                "raw.githubusercontent.com",
                "api.github.com",
                "github.com",
                "rolldown.rs",
                "eslint.style",
                "perfectionist.dev",
                "typescript-eslint.io",
                "main.oxc.rs",
                "zed.dev",
                "openrouter.ai",
                "opencode.ai",
                "pi.dev"
            ]
        },
        "default_profile": "write",
        "default_model": {
            "provider": "deepseek",
            "model": "deepseek-v4-flash",
            "enable_thinking": true,
            "effort": "max"
        },
        "tool_permissions": {
            "tools": {
                "skill": {
                    "default": "allow"
                },
                "write_file": {
                    "default": "allow"
                },
                "move_path": {
                    "default": "allow"
                },
                "copy_path": {
                    "default": "allow"
                },
                "create_directory": {
                    "default": "allow"
                },
                "delete_path": {
                    "default": "allow"
                },
                "terminal": {
                    "default": "allow"
                },
                "fetch": {
                    "default": "allow"
                }
            }
        },
        "enable_feedback": false,
        "thinking_display": "always_collapsed"
    },
    "buffer_font_family": "Comic Code Ligatures",
    "colorize_brackets": true,
    "command_aliases": {
        "f": "file_finder::Toggle",
        "only": "pane::CloseOtherItems",
        "L": "workspace::ToggleLeftDock",
        "R": "workspace::ToggleRightDock",
        "B": "workspace::ToggleBottomDock",
        "reopen": "pane::ReopenClosedItem",
        "thread": "agent::NewThread",
        "S": "multi_workspace::ToggleWorkspaceSidebar",
        "D": "debug_panel::ToggleFocus"
    },
    "confirm_quit": true,
    "debugger": {
        "dock": "left"
    },
    "diagnostics": {
        "inline": {
            "enabled": true,
            "max_severity": "error",
            "min_column": 124,
            "padding": 0
        }
    },
    "file_finder": { "modal_max_width": "medium" },
    "git": {
        "inline_blame": {
            "min_column": 124,
            "padding": 0,
            "delay_ms": 1000
        },
        "worktree_directory": "worktrees"
    },
    "gutter": {
        "folds": false,
        "bookmarks": false,
        "runnables": false
    },
    "icon_theme": "Catppuccin Macchiato",
    "indent_guides": {
        "enabled": true,
        "coloring": "indent_aware"
    },
    "markdown_preview_font_family": "Comic Code Ligatures",
    "markdown_preview_theme": "Rust & Brown",
    "pane_split_direction_horizontal": "down",
    "pane_split_direction_vertical": "right",
    "preferred_line_length": 120,
    "project_panel": {
        "hide_gitignore": false,
        "hide_root": true,
        "show_diagnostics": "off",
        "bold_folder_labels": false,
        "folder_icons": true,
        "git_status": false,
        "auto_fold_dirs": false
    },
    "relative_line_numbers": "enabled",
    "scrollbar": { "show": "always" },
    "search": {},
    "show_call_status_icon": false,
    "show_edit_predictions": false,
    "show_whitespaces": "selection",
    "status_bar": { "experimental.show": false },
    "tab_bar": {
        "show_nav_history_buttons": false,
        "show_tab_bar_buttons": false
    },
    "tabs": {
        "show_close_button": "hidden",
        "file_icons": true,
        "git_status": true
    },
    "terminal": {
        "bell": "system",
        "copy_on_select": true,
        "font_family": "Comic Code Ligatures"
    },
    "theme": "Rust & Brown",
    "title_bar": {
        "show_branch_name": false,
        "show_onboarding_banner": false,
        "show_sign_in": false,
        "show_user_menu": false
    },
    "toolbar": {
        "breadcrumbs": false,
        "agent_review": false,
        "quick_actions": false
    },
    "ui_font_family": "Comic Code Ligatures",
    "vim_mode": true
}
