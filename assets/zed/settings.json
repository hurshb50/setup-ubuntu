            "write": {
                "enable_all_context_servers": true,
                "name": "Write",
                "tools": {
                    "apply_code_action": true,
                    "ask_user": false,
                    "copy_path": true,
                    "create_directory": true,
                    "create_thread": true,
                    "delete_path": true,
                    "diagnostics": true,
                    "edit_file": true,
                    "fetch": true,
                    "find_path": true,
                    "find_references": true,
                    "get_code_actions": true,
                    "go_to_definition": true,
                    "grep": true,
                    "list_agents_and_models": true,
                    "list_directory": true,
                    "move_path": true,
                    "read_file": true,
                    "rename_symbol": true,
                    "search_web": true,
                    "skill": true,
                    "spawn_agent": true,
                    "terminal": true,
                    "write_file": true
