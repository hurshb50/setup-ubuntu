[core]
	editor = zed --wait

[init]
	defaultBranch = main

[push]
	autoSetupRemote = true

[merge]
	conflictStyle = merge

[diff]
	algorithm = histogram

[fetch]
	prune = true

[rerere]
	enabled = true

[branch]
	sort = -committerdate

[credential "https://github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential

[includeIf "hasconfig:remote.*.url:https://github.com/rai-inst/**"]
	path = ~/.config/git/work.gitconfig

[includeIf "hasconfig:remote.*.url:https://github.com/hurshb50/**"]
	path = ~/.config/git/personal.gitconfig
